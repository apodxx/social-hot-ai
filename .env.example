# ==========================
# TikHub
# ==========================

TIKHUB_API_KEY=
TIKHUB_BASE_URL=https://api.tikhub.io

# Request tuning (optional). Retries are bounded so a run cannot loop forever.
TIKHUB_TIMEOUT_SECONDS=30
TIKHUB_MAX_RETRIES=3
TIKHUB_BACKOFF_BASE_SECONDS=0.5


# ==========================
# DeepSeek (Phase 3)
# ==========================

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Confirmed against GET /models for this account: deepseek-flash, deepseek-v4-pro.
# `deepseek-chat` no longer exists and returns 404.
DEEPSEEK_MODEL=deepseek-flash

DEEPSEEK_TIMEOUT_SECONDS=120
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_MAX_TOKENS=4000


# ==========================
# Rewriting cost controls (Phase 4)
# ==========================

# Three platform versions plus hashtags need room: 3000 truncated a real run's
# JSON mid-structure, so the default is 6000.
REWRITE_MAX_TOKENS=6000

# Creative work needs more freedom than judging does.
REWRITE_TEMPERATURE=0.7

# 0 means "whatever Phase 3 selected", capped by ANALYSIS_MAX_SELECTED.
REWRITE_MAX_ITEMS=0

# Similarity against the source above which output counts as a mechanical
# rewrite (§18): regenerated once, then flagged NEEDS_REVIEW.
REWRITE_SIMILARITY_LIMIT=0.6

# How long an existing rewrite is reused (0 = never rewrite again).
REWRITE_REUSE_HOURS=24

# One stricter retry when the first attempt looks copied.
REWRITE_RETRY_ON_COPY=true


# ==========================
# Analysis cost controls (Phase 3)
# ==========================

# Items per DeepSeek request — the main cost lever (batching, not one call per item).
ANALYSIS_BATCH_SIZE=10

# Hard cap on items sent to DeepSeek after the free rule filter.
ANALYSIS_MAX_CANDIDATES=30

# Final selection size (spec: 5-10 items reach rewriting).
ANALYSIS_MAX_SELECTED=10

# A recommendation below this confidence is not selected.
ANALYSIS_MIN_CONFIDENCE=0.5

# One extra (cheap) call that merges semantically identical topics across
# platforms. Off by default: it is an extra billed request per run.
ANALYSIS_SEMANTIC_MERGE=false

# How long an existing analysis is reused (0 = never re-analyse).
ANALYSIS_REUSE_HOURS=24

# Account profile JSON; empty means <project root>/account_profile.json
ANALYSIS_PROFILE_PATH=


# ==========================
# Database
# ==========================

# Phase 2 uses PostgreSQL. The README documents a project-local cluster
# (initdb, port 55432, 127.0.0.1 only) so no machine credentials are needed;
# point this at your own server instead if you prefer.
DATABASE_URL=postgresql+asyncpg://postgres@127.0.0.1:55432/social_hot_ai


# ==========================
# Hot Config
# ==========================

HOT_LIMIT_PER_PLATFORM=50

HOT_FETCH_TIMES=08:00,12:00,18:00


# ==========================
# Deduplication (Phase 2)
# ==========================

# Title-similarity ratio at or above which two titles count as the same item.
# Layer 3 is scoped per platform; cross-platform twins are grouped, not dropped.
DEDUP_TITLE_SIMILARITY=0.82

# Only items newer than this are compared, so a run's work stays bounded.
DEDUP_WINDOW_HOURS=48

# Hard cap on items pulled into one clustering pass.
DEDUP_MAX_COMPARE=400


# ==========================
# Scheduler (Phase 5)
# ==========================

SCHEDULER_ENABLED=true

# Cron timezone for HOT_FETCH_TIMES (local wall-clock).
SCHEDULER_TIMEZONE=Asia/Shanghai

# A task still marked running after this long is treated as crashed.
TASK_STALE_MINUTES=30


# ==========================
# Detail fetching (§16) — BILLED
# ==========================

# One billed TikHub call per selected item. Off by default: with it off, the
# rewriter works from headlines only and must not invent specifics.
DETAIL_FETCH_ENABLED=false

# Cap on detail fetches per run.
DETAIL_MAX_ITEMS=10


# ==========================
# Notification (Phase 6)
# ==========================

# `log` writes to the application log and needs no credentials — use it to verify
# the whole notification path. `wechat` / `qq` are the real channels.
NOTIFICATION_ENABLED=false
NOTIFICATION_CHANNEL=log

# Comma-separated list; when set it wins over NOTIFICATION_CHANNEL.
NOTIFICATION_CHANNELS=

# Message ceiling before splitting (§28).
NOTIFICATION_MAX_CHARS=1500

# How many rewrites one digest covers.
NOTIFICATION_MAX_ITEMS=10


# ==========================
# WeChat — 企业微信 group robot (official API)
# ==========================

WECHAT_ENABLED=false
WECHAT_WEBHOOK_URL=
WECHAT_MSGTYPE=markdown


# ==========================
# QQ — 开放平台 Bot (official API only)
# ==========================

# NOTE: implemented against the published API but never exercised; it needs real
# credentials (app id, secret, and a channel or an openid that has interacted).
QQ_ENABLED=false
QQ_APP_ID=
QQ_APP_SECRET=
QQ_BOT_TOKEN=
QQ_TARGET_OPENID=
QQ_CHANNEL_ID=
QQ_SANDBOX=false


# ==========================
# Server (optional)
# ==========================

APP_HOST=127.0.0.1
APP_PORT=8000

# ==========================
# MCP server (Phase 8)
# ==========================

# Mounts the MCP endpoint at http://127.0.0.1:8000/mcp/ so an AI client can read the
# pipeline and (optionally) trigger it. The Host header is validated: only
# 127.0.0.1 / localhost / [::1] may reach it.
MCP_ENABLED=true

# When false, the spending tools (collection / analysis / rewrite / pipeline) are not
# registered at all. Turn this off to keep the MCP surface read-only.
MCP_ALLOW_BILLED=true

# ==========================
# Keyword search + media library (Phase 9)
# ==========================

# Hits kept per platform per keyword. Does NOT change the cost: one search is one
# billed call per platform regardless of how many results are kept.
SEARCH_LIMIT_PER_PLATFORM=20
SEARCH_PLATFORMS=xiaohongshu,douyin,weibo

# Download images into the local material library. On by default because the provider
# image URLs are signed and expire — a row that only stores the link is not saved.
MEDIA_DOWNLOAD_ENABLED=true
MEDIA_ROOT=media
MEDIA_MAX_IMAGES_PER_ITEM=9
# 8 MiB: provider images are a few hundred KB, so this only catches a redirect to
# something that is not an image at all.
MEDIA_MAX_BYTES_PER_FILE=8388608
MEDIA_TIMEOUT_SECONDS=20
# Wall-clock budget for one download batch, so a slow CDN cannot stall a run.
MEDIA_BATCH_SECONDS=120

# ==========================
# Domain focus (Phase 10)
# ==========================

# The topics this account publishes about. Used to RANK (and optionally drop) what gets
# sent to the paid AI analysis, so the money goes to technology/programming content
# instead of whatever is trending. Matching is free and deterministic: it can reorder
# and remove, but it cannot create — a board with no technology items yields none,
# which is what WATCH_KEYWORDS below is for.
INTEREST_KEYWORDS=科技,数码,人工智能,AI,大模型,机器学习,编程,代码,程序员,开发者,开源,GitHub,计算机,软件,算法,数据库,前端,后端,Python,Java,JavaScript,Linux,考研,大学生,学生,毕业,毕业季,求职,就业,实习,校园,面试
INTEREST_NEGATIVE_KEYWORDS=明星,八卦,恋情,绯闻,离婚,出轨,综艺,选秀,球赛,彩票
# true = items matching no interest keyword are not analysed at all (cheaper, but a run
# with no relevant candidates analyses nothing and says so).
INTEREST_ONLY=true

# Scheduled domain searches. **Each keyword costs one billed search per platform per
# run.** With the defaults (3 keywords x 2 platforms) that is 6 billed calls per run;
# at the default three runs a day that is 18 calls/day. Reduce HOT_FETCH_TIMES or the
# keyword list to spend less, or set WATCH_SEARCH_ENABLED=false to stop it entirely.
WATCH_SEARCH_ENABLED=true
WATCH_KEYWORDS=AI工具,编程学习,数码好物
WATCH_SEARCH_PLATFORMS=xiaohongshu,douyin
WATCH_SEARCH_LIMIT=10
WATCH_DOWNLOAD_MEDIA=true

# ==========================
# Image generation / 图片二创 (Phase 11)
# ==========================

# Alibaba Model Studio (DashScope). **The workspace-scoped endpoint, not the shared one**:
# the model, endpoint and key must belong to the same region or calls fail.
# Workspace endpoints look like https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
QWEN_IMAGE_MODEL=qwen-image-3.0-pro

IMAGE_GEN_ENABLED=true

# **Billed per image, not per token** — published price (China Beijing):
#   1K output $0.03438/image, 2K output $0.068761/image, input image $0.00275 each.
# 1024*1024 is inside the 1K tier, so it is ~¥0.25 per image — roughly 15x a whole
# text rewrite. Nothing generates an image automatically; every call is a deliberate
# click, and the API reports the exact price before you make it.
# NOTE: DashScope separates width and height with '*'; the OpenAI-compatible mode uses 'x'.
IMAGE_GEN_SIZE=1024*1024
# Every extra output image is billed separately.
IMAGE_GEN_N=1
# Hard ceiling per run, so a loop bug cannot fan out into dozens of paid images.
IMAGE_GEN_MAX_PER_RUN=2
# Generation is slow, and the model is rate limited to 5 requests per minute.
IMAGE_GEN_TIMEOUT_SECONDS=300

# ==========================
# Logging (optional)
# ==========================

LOG_LEVEL=INFO
